{
  "name": "bping",
  "version": "1.0.10",
  "description": "Basecamp Pings — native wrapper that embeds the real Basecamp chat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . bping --platform=darwin --arch=arm64 --overwrite --out=dist --icon=icon.icns --app-bundle-id=com.decent.bping --app-category-type=public.app-category.productivity",
    "dmg": "./build-dmg.sh"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "@electron/packager": "^18.4.0"
  }
}
